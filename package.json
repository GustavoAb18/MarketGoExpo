{
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest && node --test \"supabase/tests/*.test.mjs\"",
    "test:app": "jest",
    "test:db": "node --test \"supabase/tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app src __tests__ supabase/tests"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}